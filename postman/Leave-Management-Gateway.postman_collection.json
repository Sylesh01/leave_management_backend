                  "const json = pm.response.json();",
                  "pm.test('Correct employee_id', () => pm.expect(json.employee_id).to.eql(101));",
                  "pm.test('Has applications array', () => pm.expect(json.applications).to.be.an('array'));",
                  "pm.test('Applications have required fields', () => {",
                  "  if (json.applications.length > 0) {",
                  "    const row = json.applications[0];",
                  "    pm.expect(row).to.have.keys('leave_id','leave_type','start_date','end_date','days','reason','status','rejection_comments','processed_at','processed_by','reporting_manager');",
                  "  }",
                  "});",
                  "pm.test('Sorted newest first by leave_id', () => {",
                  "  const ids = json.applications.map(a => a.leave_id);",
                  "  const sorted = [...ids].sort((a, b) => b - a);",
                  "  pm.expect(ids).to.eql(sorted);",
                  "});"
                ],
                "type": "text/javascript"
              }
