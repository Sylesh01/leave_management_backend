        {
          "name": "POS - Leave details own (101)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('Single employee in response', () => pm.expect(json.employees).to.have.lengthOf(1));",
                  "pm.test('Has sick/casual/privilege/total', () => {",
                  "  const leaves = json.employees[0].leaves;",
                  "  pm.expect(leaves).to.have.keys('sick','casual','privilege','total');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{employee_token}}" }
            ],
            "url": "{{baseUrl}}/employees/101/leave-details"
          }
        },
        {
          "name": "POS - Create employee (mark)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "const json = pm.response.json();",
                  "pm.test('Correct username', () => pm.expect(json.username).to.eql('mark'));",
                  "pm.test('Default casual balance 12', () => pm.expect(json.leave_balance.casual).to.eql(12));",
                  "pm.test('Default sick balance 10', () => pm.expect(json.leave_balance.sick).to.eql(10));",
                  "pm.test('Default privilege balance 15', () => pm.expect(json.leave_balance.privilege).to.eql(15));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{admin_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"mark\",\n  \"password\": \"mark123\",\n  \"name\": \"Mark Taylor\",\n  \"role\": \"employee\",\n  \"department\": \"Engineering\",\n  \"manager_id\": 201\n}"
            },
            "url": "{{baseUrl}}/employees"
